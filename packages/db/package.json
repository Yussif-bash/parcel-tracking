    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@parcel/shared": "workspace:*",
    "electrodb": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "aws-sdk-client-mock": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
